{
  "tech_stack": ["Node.js", "Express.js", "Prisma", "PostgreSQL", "JWT", "bcrypt", "helmet", "morgan", "cors"],
  "features": [
    {
      "name": "Authentication",
      "description": "User registration, login, token verification, and OTP verification.",
      "files": ["routes/auth.js", "controllers/authController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Auth API", "version": "1.0.0" },
        "paths": {
          "/api/auth/register": { "post": { "summary": "Register new user" } },
          "/api/auth/login": { "post": { "summary": "User login" } },
          "/api/auth/verify": { "get": { "summary": "Verify token" } },
          "/api/auth/verify-otp": { "post": { "summary": "Verify OTP" } }
        }
      }
    },
    {
      "name": "Certificates",
      "description": "Discovery and management of certificates.",
      "files": ["routes/certificates.js", "controllers/certificateController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Certificates API", "version": "1.0.0" },
        "paths": {
          "/api/certificates": { "get": { "summary": "List all certificates" } },
          "/api/certificates/search": { "get": { "summary": "Search certificates" } },
          "/api/certificates/{id}": { "get": { "summary": "Get certificate by ID" } },
          "/api/certificates/{id}/save": { "post": { "summary": "Save certificate" } },
          "/api/certificates/{id}/save": { "delete": { "summary": "Unsave certificate" } }
        }
      }
    },
    {
      "name": "Internships",
      "description": "Internship opportunities and applications.",
      "files": ["routes/internships.js", "controllers/internshipController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Internships API", "version": "1.0.0" },
        "paths": {
          "/api/internships": { "get": { "summary": "List internships" } },
          "/api/internships/search": { "get": { "summary": "Search internships" } },
          "/api/internships/{id}": { "get": { "summary": "Get internship by ID" } },
          "/api/internships/{id}/save": { "post": { "summary": "Save internship" } },
          "/api/internships/{id}/apply": { "post": { "summary": "Apply for internship" } }
        }
      }
    },
    {
      "name": "Hackathons",
      "description": "Hackathon calendar and registration.",
      "files": ["routes/hackathons.js", "controllers/hackathonController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Hackathons API", "version": "1.0.0" },
        "paths": {
          "/api/hackathons": { "get": { "summary": "List hackathons" } },
          "/api/hackathons/upcoming": { "get": { "summary": "Upcoming hackathons" } },
          "/api/hackathons/{id}": { "get": { "summary": "Get hackathon by ID" } },
          "/api/hackathons/{id}/save": { "post": { "summary": "Save hackathon" } }
        }
      }
    },
    {
      "name": "News",
      "description": "Tech news feed.",
      "files": ["routes/news.js", "controllers/newsController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "News API", "version": "1.0.0" },
        "paths": {
          "/api/news": { "get": { "summary": "Latest news" } },
          "/api/news/category/{category}": { "get": { "summary": "News by category" } },
          "/api/news/search": { "get": { "summary": "Search news" } }
        }
      }
    },
    {
      "name": "Tools",
      "description": "AI tool recommendations.",
      "files": ["routes/tools.js", "controllers/toolController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Tools API", "version": "1.0.0" },
        "paths": {
          "/api/tools": { "get": { "summary": "All tools" } },
          "/api/tools/recommendations": { "get": { "summary": "Get recommendations" } },
          "/api/tools/category/{category}": { "get": { "summary": "Tools by category" } }
        }
      }
    },
    {
      "name": "Projects",
      "description": "Project ideas and management.",
      "files": ["routes/projects.js", "controllers/projectController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Projects API", "version": "1.0.0" },
        "paths": {
          "/api/projects": { "get": { "summary": "All projects" } },
          "/api/projects/generate": { "post": { "summary": "Generate project ideas" } },
          "/api/projects/{id}": { "get": { "summary": "Get project by ID" } },
          "/api/projects/{id}/start": { "post": { "summary": "Start project" } }
        }
      }
    },
    {
      "name": "Users",
      "description": "User profile and saved items management.",
      "files": ["routes/users.js", "controllers/userController.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": { "title": "Users API", "version": "1.0.0" },
        "paths": {
          "/api/users/profile": { "get": { "summary": "Get user profile" }, "put": { "summary": "Update profile" } },
          "/api/users/skills": { "post": { "summary": "Add skill" } },
          "/api/users/skills/{skillId}": { "delete": { "summary": "Remove skill" } },
          "/api/users/saved": { "get": { "summary": "Get saved items" } },
          "/api/users/applications": { "get": { "summary": "Get applications" } }
        }
      }
    }
  ]
}
