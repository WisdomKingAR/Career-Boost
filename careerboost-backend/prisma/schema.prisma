// Prisma Schema for CareerBoost - Refactored for SQLite with OTP support
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  name          String
  bio           String?
  avatar        String?
  location      String    @default("Mumbai, India")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  skills        UserSkill[]
  preferences   Preference?
  savedItems    SavedItem[]
  applications  Application[]
  projects      UserProject[]
}

// Temporary storage for users waiting for OTP verification
model PendingUser {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  name          String
  location      String?
  otp           String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

// User skills
model UserSkill {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName     String
  proficiency   String    @default("beginner") // beginner, intermediate, advanced
  
  @@unique([userId, skillName])
}

// User preferences
model Preference {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocation String  @default("remote")
  minStipend      Int       @default(0)
  maxDuration     Int       @default(12)
  interests       String    @default("[]") // Store as JSON string for SQLite
  difficultyLevel String    @default("[\"beginner\", \"intermediate\"]") // Store as JSON string for SQLite
}

// Certificates
model Certificate {
  id          String    @id @default(cuid())
  name        String
  issuer      String
  url         String
  duration    Int       // in hours
  cost        Float
  level       String    // beginner, intermediate, advanced
  skills      String    @default("[]") // Store as JSON string
  salaryImpact String?
  deadline    DateTime?
  description String?
  createdAt   DateTime  @default(now())
}

// Internships
model Internship {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String
  remote      Boolean   @default(false)
  duration    Int       // in months
  stipend     Float?
  skills      String    @default("[]") // Store as JSON string
  deadline    DateTime
  applicationUrl String
  description String
  createdAt   DateTime  @default(now())
  
  applications Application[]
}

// Hackathons
model Hackathon {
  id          String    @id @default(cuid())
  name        String
  platform    String
  startDate   DateTime
  endDate     DateTime
  prizePool   Float?
  location    String
  remote      Boolean   @default(true)
  teamSize    String
  skills      String    @default("[]") // Store as JSON string
  registerUrl String
  description String
  createdAt   DateTime  @default(now())
}

// News articles
model News {
  id          String    @id @default(cuid())
  headline    String
  description String
  category    String    // AI, Cybersecurity, DataScience
  source      String
  sourceUrl   String
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime  @default(now())
}

// AI Tools
model Tool {
  id          String    @id @default(cuid())
  name        String
  category    String
  description String
  url         String
  documentation String
  difficulty  String    // beginner, intermediate, advanced
  pricing     String?
  freeTier    Boolean   @default(false)
  features    String    @default("[]") // Store as JSON string
  createdAt   DateTime  @default(now())
}

// Project ideas
model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  difficulty  String
  duration    Int       // in weeks
  techStack   String    @default("[]") // Store as JSON string
  skills      String    @default("[]") // Store as JSON string
  steps       String    @default("[]") // Store as JSON string
  resources   String    @default("[]") // Store as JSON string
  createdAt   DateTime  @default(now())
  
  userProjects UserProject[]
}

// User projects
model UserProject {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String    @default("planning") // planning, inProgress, completed
  startedAt DateTime  @default(now())
  
  @@unique([userId, projectId])
}

// Saved items
model SavedItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String    // certificate, internship, hackathon
  itemId    String
  
  createdAt   DateTime  @default(now())
  
  @@unique([userId, itemId])
}

// Applications
model Application {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  internshipId String
  internship  Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status      String    @default("applied") // applied, under_review, accepted, rejected
  appliedAt   DateTime  @default(now())
  
  @@unique([userId, internshipId])
}
